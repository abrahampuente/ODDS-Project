# API key de https://the-odds-api.com (32 caracteres hexadecimales)
ODDS_API_KEY=
# Peticiones mínimas a conservar en la cuota mensual antes de dejar de consultar
MIN_QUOTA_RESERVE=50
# Comisión de exchanges sobre la ganancia (por defecto Betfair 5%, Matchbook y Smarkets 2%).
# Ajusta según tu cuenta, p. ej.: EXCHANGE_COMMISSIONS=betfair_ex_eu:0.03,matchbook:0.015
EXCHANGE_COMMISSIONS=
# Tope de consultas por mes del escaneo programado (docker compose --profile scheduler)
SCHEDULE_MONTHLY_BUDGET=60
